# ---------------------------------------------------------------------------
# backend — copy to backend/.env
# ---------------------------------------------------------------------------
# The credentials file. backend/api is the only service that holds these, and
# the Prisma CLI (migrate, seed, studio) reads the same file so a migration and
# the running service can never disagree about which database they mean.

# Railway MySQL 8. On Railway use the INTERNAL hostname; the public TCP proxy
# adds latency and billable egress.
#   internal: mysql://user:pass@mysql.railway.internal:3306/railway
#   public:   mysql://user:pass@<host>.proxy.rlwy.net:<port>/railway
DATABASE_URL="mysql://root:password@127.0.0.1:3306/buildkart"

# Signs admin session tokens. Held ONLY here — the admin cannot mint or verify
# a session, which is the point.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# Signs storefront customer session tokens. A SEPARATE key from the admin's, and
# the API refuses to start if the two are equal: the storefront hands a token to
# anyone who can receive an SMS, so a shared key would let "I own a phone" carry
# an admin signature.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CUSTOMER_SESSION_SECRET=""

# Encrypts credentials stored in the `Setting` table — payment gateway salts and
# API keys today, SMS and SMTP passwords later — and each admin's two-step
# sign-in secret. Without it the admin refuses to save a credential rather than
# storing it in the clear, and two-step sign-in cannot be turned on. Never
# change it once set: every sealed value, sign-in secrets included, would stop
# opening (see docs/PRIVACY.md, "Rotating keys").
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SETTINGS_ENCRYPTION_KEY=""

# Bearer secret for the /cron/* endpoints. Point Railway cron at the API:
#   GET <api>/cron/media-gc
#   GET <api>/cron/publish-scheduled
#   GET <api>/cron/payment-sessions   (every 5 minutes)
#   GET <api>/cron/marketing          (every 10 minutes — Meta Conversions API
#                                      retries, and clears order IPs after 10 days)
#   GET <api>/cron/analytics          (hourly — session funnel summary)
#   GET <api>/cron/meta-insights      (every 6 hours — Meta ad spend)
#   GET <api>/cron/privacy            (daily — account deletions whose week is
#                                      up, and personal data past its retention)
CRON_SECRET=""

# Optional. The Graph API version Meta's Conversions API is called on; the code
# default is in core/src/marketing/meta-capi.ts. Set this to move to a newer
# version without a code change when Meta retires the default.
# META_GRAPH_VERSION="v23.0"

# ---------------------------------------------------------------------------
# Online payments (Razorpay / PayU)
# ---------------------------------------------------------------------------
# The storefront's public address. PayU sends the customer back to
# <WEBSITE_URL>/api/payments/payu/return; without it PayU is skipped and the
# next gateway in priority takes the payment.
WEBSITE_URL="https://buildkart.co"

# The admin's public address. Optional: the "New order alert" and "Security
# alert" WhatsApps to the shop's numbers can then link straight to the order or
# the screen to check ({{adminOrderUrl}}, {{adminUrl}}).
ADMIN_URL="https://admin.buildkart.co"

# This API's public address, shown on the admin Payments screen as the webhook
# URLs to paste into Razorpay and PayU:
#   <API_PUBLIC_URL>/webhooks/razorpay
#   <API_PUBLIC_URL>/webhooks/payu
API_PUBLIC_URL="https://api.buildkart.co"

# Proves a caller is one of our apps. Must match SERVICE_TOKEN in admin/.env.
# UNSET MEANS EVERY REQUEST IS REFUSED — a missing variable must never be the
# thing that opens the door.
SERVICE_TOKEN=""

# --- The mobile app's door (/app/…) -----------------------------------------
# A phone cannot hold SERVICE_TOKEN, so the app proves itself with Firebase App
# Check instead (Play Integrity on Android, App Attest on iOS).
#
# Firebase console → Project settings → General: the project NUMBER (digits,
# not the project id), and each app's App ID, comma-separated.
# UNSET MEANS EVERY /app/ REQUEST IS REFUSED, for the same reason as above.
FIREBASE_PROJECT_NUMBER=""
FIREBASE_APP_IDS=""

# "monitor" lets a phone that FAILS App Check through, and logs it. For the
# first beta builds only, while attestation is tuned on real phones — never on
# the live shop for long. Anything else (or unset) enforces.
# APP_CHECK_MODE="enforce"

# Set to "true" only once api.buildkart.co is proxied by Cloudflare (orange
# cloud). The app door then takes the phone's address from cf-connecting-ip.
# Without Cloudflare in front anyone can send that header, so leave it unset.
# TRUST_CLOUDFLARE_IP="false"

API_PORT="3002"

# Set to "true" to include stack traces in API error responses. Local debugging
# only: tRPC would otherwise leak them whenever NODE_ENV is not exactly
# "production", which is one forgotten variable away from serving internal paths.
# API_DEBUG_ERRORS="false"

# Set to "true" to show the sign-in code on screen when no WhatsApp sign-in
# template is configured. Local development only: with it on, anyone can sign
# in as any number. Unset, sign-in refuses until WhatsApp is set up.
# OTP_DEV_ECHO="false"

# Owner accounts must use two-step sign-in (a code from an authenticator app)
# whenever SETTINGS_ENCRYPTION_KEY is set. "true" makes it optional for owners
# too. Local development only — never on the live shop.
# ADMIN_2FA_OPTIONAL="false"

# The first admin owner, created by the seed only when no owner exists yet.
# Without SEED_OWNER_PASSWORD a password is generated and printed once.
# Never put these in package.json or anywhere else in git.
# SEED_OWNER_EMAIL="owner@example.com"
# SEED_OWNER_PASSWORD=""

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible)
# ---------------------------------------------------------------------------
# From R2 -> Manage API tokens -> Create API token (Object Read & Write).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="buildkart-media"
# Optional: derived from R2_ACCOUNT_ID when omitted.
# R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"

# Where customers read images from. A *.r2.dev development URL cannot have
# Cloudflare Image Transformations enabled; a custom domain in your own zone can.
R2_PUBLIC_BASE_URL="https://cdn.buildkart.co"
# Auto-detected from the host above. Set "false" for a custom domain whose zone
# does not yet have transformations on, or resized URLs will 404.
# R2_IMAGE_TRANSFORMS="true"

# Browser uploads go straight to R2, so the BUCKET must allow the admin origin
# or every upload dies at the CORS preflight. Apply with: npm run r2:cors
# R2_CORS_ORIGINS=""

MEDIA_MAX_BYTES="10485760"
MEDIA_ALLOWED_MIME="image/jpeg,image/png,image/webp,image/avif"
