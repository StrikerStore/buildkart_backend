save-exact=true
engine-strict=true
fund=false
audit=false

# Needed to publish `@StrikerStore/contract` to GitHub Packages.
# Use a PAT with `write:packages` for publish; `read:packages` is enough to install.
@StrikerStore:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
