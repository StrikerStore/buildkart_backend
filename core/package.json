{
  "name": "@buildkart/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain services — the only code that reads or writes the database. Framework-free: no Next, no React, no server-only. Runnable under plain `node --test`.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --test \"src/**/*.itest.ts\"",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@buildkart/database": "*",
    "@buildkart/shared": "*",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.2",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
